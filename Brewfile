# ==============================================================================
# Homebrew Bundle (Brewfile) - macOS 개발 환경 및 필수 앱 일괄 설치
# 실행 명령: brew bundle (또는 bash install-apps.sh)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 버전 관리 및 GitHub CLI
# ------------------------------------------------------------------------------
brew "git"
brew "gh"

# ------------------------------------------------------------------------------
# 2. 언어 런타임 및 개발 유틸리티
# ------------------------------------------------------------------------------
brew "fnm"              # 고속 Node.js 버전 관리자
brew "python@3.12"      # Python 3.12
brew "direnv"           # 디렉토리별 환경변수 자동 로더
brew "tokei"            # 코드베이스 메트릭스 및 라인 수 분석 도구

# ------------------------------------------------------------------------------
# 3. 컨테이너 환경 (Docker Desktop & Podman 둘 다 지원)
# ------------------------------------------------------------------------------
cask "docker"           # Docker Desktop
brew "podman"           # 오픈소스 무료 컨테이너 엔진
brew "podman-compose"   # Podman Compose CLI
cask "podman-desktop"   # Podman GUI 대시보드

# ------------------------------------------------------------------------------
# 4. 코드 에디터 및 AI 도구
# ------------------------------------------------------------------------------
cask "visual-studio-code"
brew "antigravity-cli"    # Google Antigravity CLI (명령어: agy)
tap "stablyai/orca"
cask "orca"

# ------------------------------------------------------------------------------
# 5. 보안 및 비밀번호 관리
# ------------------------------------------------------------------------------
cask "keepassxc"        # 팀/개인 비밀번호 금고 및 시크릿 관리
brew "rclone"           # 클라우드 스토리지(Google Drive) 동기화 도구

# ------------------------------------------------------------------------------
# 6. 터미널 및 셸 생산성
# ------------------------------------------------------------------------------
cask "ghostty"          # 최신 고속 GPU 가속 터미널 (또는 iTerm2)
brew "eza"              # 아이콘 및 Git 상태를 지원하는 차세대 ls
brew "zoxide"           # 스마트 디렉토리 이동 (cd 대체 'z')
brew "fzf"              # 고속 대화형 퍼지 검색기
brew "fd"               # find 대체 고속 파일 탐색기
brew "bat"              # 구문 강조 지원 cat 대체 유틸리티
brew "tmux"             # 터미널 멀티플렉서
cask "font-meslo-lg-nerd-font" # Oh My Posh 권장 Nerd Font (기호/아이콘 지원)
cask "font-d2coding-nerd-font" # D2Coding 한글/영문 고정폭 Nerd Font

# ------------------------------------------------------------------------------
# 7. 데이터베이스 도구 (SSMS Mac 대체)
# ------------------------------------------------------------------------------
cask "azure-data-studio" # MS 공식 크로스플랫폼 SQL 툴 (SSMS 완벽 대응)
cask "dbeaver-community" # 올인원 범용 데이터베이스 관리자

# ------------------------------------------------------------------------------
# 8. 원격 데스크톱 (Windows RDCMan 대체)
# ------------------------------------------------------------------------------
cask "windows-app"       # Microsoft 공식 원격 데스크톱 클라이언트 (사내 Windows 서버 RDP 접속)

# ------------------------------------------------------------------------------
# 9. 지식 관리 및 위키
# ------------------------------------------------------------------------------
cask "obsidian"          # Obsidian 마크다운 지식 베이스 Vault

# ------------------------------------------------------------------------------
# 10. Windows 사용자를 위한 Mac 필수 생산성 유틸리티 (역체감 제로)
# ------------------------------------------------------------------------------
cask "alt-tab"           # Windows 스타일 창 단위 Alt+Tab 전환 도구
cask "rectangle"         # Win+방향키 화면 분할 단축키 도구 (2분할/4분할)
cask "raycast"           # 차세대 Spotlight 대체 런처 (클립보드 히스토리, 스니펫)

# ------------------------------------------------------------------------------
# 11. Microsoft 365 & 회사 협업 도구
# ------------------------------------------------------------------------------
cask "microsoft-teams"   # New Teams 사내 협업/메신저
cask "microsoft-outlook" # 회사 메일 및 캘린더
cask "onedrive"          # 클라우드 스토리지 (Files On-Demand 지원)
cask "microsoft-office"  # Word, Excel, PowerPoint 오피스 패키지
cask "microsoft-edge"    # 회사 M365/SharePoint SSO 최적화 브라우저
cask "company-portal"    # MS Intune 기기 등록 포털 (회사 보안 정책 연동)

