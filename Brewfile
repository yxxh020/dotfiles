# ==============================================================================
# Homebrew Bundle (Brewfile) - macOS 필수 개발 도구 및 앱 목록
# 실행 명령: brew bundle
# ==============================================================================

# --- CLI 도구 ---
brew "git"
brew "gh"
brew "fnm"              # 고속 Node.js 버전 관리자
brew "python@3.12"
brew "direnv"           # 디렉토리별 환경변수 관리
brew "tokei"            # 코드 라인 수 분석 도구
brew "oh-my-posh"       # 터미널 프롬프트 테마

# --- 컨테이너 도구 (Docker Desktop 대체 - 완전 무료 오픈소스) ---
brew "podman"
brew "podman-compose"
cask "podman-desktop"   # Podman GUI 대시보드

# --- GUI 애플리케이션 (Casks) ---
cask "visual-studio-code"
cask "keepassxc"        # 패스워드 금고 및 시크릿 관리
cask "ghostty"          # 최신 고속 GPU 가속 터미널

# --- 데이터베이스 도구 (SSMS Mac 대체품) ---
# ⚠️ SSMS는 Windows 전용이므로, Mac에서는 MS 공식 크로스플랫폼 도구를 사용합니다.
cask "azure-data-studio" # Microsoft 공식 SSMS 맥북 대응 도구
cask "dbeaver-community" # 강력한 크로스 플랫폼 올인원 SQL 클라이언트

# --- AI 에이전트 & 오케스트레이터 ---
# Orca 데스크톱 (Homebrew 지원 시 또는 onorca.dev)
# cask "orca"
