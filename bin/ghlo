#!/usr/bin/env python3
# GitHub 이슈 목록 조회 (제목 극대화, 반응형 터미널 너비 및 얼룩말 배경색 스트라이프)


import json
import os
import shutil
import subprocess
import sys
import unicodedata
from datetime import datetime, timezone




def char_width(c):
    """동아시아 문자(한글/한자 등)의 터미널 출력 폭 계산 (CJK: 2, 일반: 1)"""
    w = unicodedata.east_asian_width(c)
    return 2 if w in ('W', 'F') else 1




def str_width(s):
    return sum(char_width(c) for c in s)




def truncate_str(s, max_width):
    cur = 0
    res = []
    for c in s:
        w = char_width(c)
        if cur + w > max_width:
            break
        res.append(c)
        cur += w
    return ''.join(res)




def pad_str(s, width, align='left'):
    w = str_width(s)
    if w >= width:
        return truncate_str(s, width)
    diff = width - w
    if align == 'right':
        return ' ' * diff + s
    return s + ' ' * diff




def short_time(iso_str):
    if not iso_str:
        return '-'
    try:
        dt = datetime.fromisoformat(iso_str.replace('Z', '+00:00'))
        now = datetime.now(timezone.utc)
        diff = int((now - dt).total_seconds())
        if diff < 60:
            return f'{diff}s'
        elif diff < 3600:
            return f'{diff // 60}m'
        elif diff < 86400:
            return f'{diff // 3600}h'
        elif diff < 86400 * 30:
            return f'{diff // 86400}d'
        elif diff < 86400 * 365:
            return f'{diff // (86400 * 30)}mo'
        else:
            return f'{diff // (86400 * 365)}y'
    except Exception:
        return '-'




LABEL_MAP = {
    'documentation': 'docs',
    'enhancement': 'feat',
    'refactor': 'refactor',
    'bug': 'bug',
    'duplicate': 'dupe',
    'question': 'quest',
    'wontfix': 'wontfix',
    'pending': 'pending',
}




def shorten_label(lbl, max_w=8):
    if not lbl:
        return '-'
    name = lbl.lower()
    short = LABEL_MAP.get(name, lbl)
    return short[:max_w]




def main():
    cols = shutil.get_terminal_size((80, 24)).columns


    cmd = [
        'gh',
        'issue',
        'list',
        '--state',
        'open',
        '--limit',
        '50',
        '--json',
        'number,title,author,assignees,labels,updatedAt',
    ]
    cmd.extend(sys.argv[1:])


    try:
        res = subprocess.run(cmd, capture_output=True, text=True, check=True)
        items = json.loads(res.stdout)
    except Exception as e:
        sys.exit(f'Error running gh: {e}')


    if not items:
        print('No open issues found.')
        return


    # 고정 컬럼 폭 설정
    w_num = 5
    w_auth = 5
    w_assg = 5
    w_label = 8
    w_upd = 4


    # 간격 합계: num(5) + 1 + auth(5) + 1 + assg(5) + 1 + label(8) + 1 + title + 1 + upd(4)
    fixed = w_num + 1 + w_auth + 1 + w_assg + 1 + w_label + 1 + 1 + w_upd
    w_title = max(15, cols - fixed)


    # 헤더 출력 (볼드 흰색)
    hdr = f"{pad_str('NUM', w_num)} {pad_str('AUTH', w_auth)} {pad_str('ASSG', w_assg)} {pad_str('LABEL', w_label)} {pad_str('TITLE', w_title)} {pad_str('UPD', w_upd, 'right')}"
    print(f'\033[1;37m{hdr}\033[0m')


    for i, item in enumerate(items):
        num = f"#{item['number']}"
        auth = item['author']['login'] if item.get('author') else '-'
        assg = item['assignees'][0]['login'] if item.get('assignees') else '-'
        lbl = item['labels'][0]['name'] if item.get('labels') else '-'
        label = shorten_label(lbl, w_label)
        title = item.get('title', '')
        upd = short_time(item.get('updatedAt'))


        c_num = pad_str(num, w_num)
        c_auth = pad_str(auth[:w_auth], w_auth)
        c_assg = pad_str(assg[:w_assg], w_assg)
        c_label = pad_str(label, w_label)
        c_title = pad_str(title, w_title)
        c_upd = pad_str(upd, w_upd, 'right')


        row_content = f'{c_auth} {c_assg} {c_label} {c_title} {c_upd}'


        if i % 2 == 1:
            # 짝수 번째 데이터 행: watch -c 호환 ANSI 100m 배경 + 녹색 번호(32m)
            print(f'\033[100m\033[32m{c_num}\033[39m {row_content}\033[0m')
        else:
            # 홀수 번째 데이터 행: 기본 배경 + 녹색 번호(32m)
            print(f'\033[32m{c_num}\033[39m {row_content}\033[0m')




if __name__ == '__main__':
    main()
