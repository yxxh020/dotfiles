#!/usr/bin/env bash
# ==============================================================================
# agy-switch: Google Antigravity CLI 계정 스위처
# macOS (Keychain + Symlink) 및 Linux 공용 지원
#
# 원리:
# macOS의 agy는 1순위로 시스템 Keychain (service: gemini, account: antigravity)을,
# 2순위로 ~/.gemini/antigravity-cli/antigravity-oauth-token 파일을 참조합니다.
# agy-switch는 두 저장소를 모두 원자적으로 동기화 전환하여 완벽한 계정 스위칭을 제공합니다.
# ==============================================================================

set -euo pipefail

CLI_DIR="$HOME/.gemini/antigravity-cli"
GEMINI_DIR="$HOME/.gemini"
TOKEN_STORE="$GEMINI_DIR/antigravity-tokens"

ACTIVE_TOKEN="$CLI_DIR/antigravity-oauth-token"
LEGACY_ACTIVE_TOKEN="$GEMINI_DIR/jetski-standalone-oauth-token"

# 컬러 출력
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
BLUE="\033[1;34m"
RED="\033[1;31m"
CYAN="\033[1;36m"
RESET="\033[0m"

mkdir -p "$CLI_DIR" "$TOKEN_STORE"

IS_DARWIN=false
if [[ "$OSTYPE" == "darwin"* ]]; then
    IS_DARWIN=true
fi

# 키체인에서 현재 원시 토큰 읽기 (macOS)
get_keychain_token() {
    if $IS_DARWIN; then
        security find-generic-password -s gemini -a antigravity -w 2>/dev/null || true
    else
        echo ""
    fi
}

# 키체인 토큰 설정 (macOS)
set_keychain_token() {
    local val="$1"
    if $IS_DARWIN; then
        security add-generic-password -s gemini -a antigravity -w "$val" -U >/dev/null 2>&1
    fi
}

# 키체인 토큰 삭제 (macOS)
delete_keychain_token() {
    if $IS_DARWIN; then
        security delete-generic-password -s gemini -a antigravity >/dev/null 2>&1 || true
    fi
}

# 현재 활성 계정 감지
get_current_account() {
    if $IS_DARWIN; then
        local kc_val
        kc_val=$(get_keychain_token)
        if [[ -n "$kc_val" ]]; then
            # TOKEN_STORE 내의 .keychain 파일들과 내용 비교
            for kf in "$TOKEN_STORE"/*.keychain; do
                [[ -f "$kf" ]] || continue
                local saved_val
                saved_val=$(cat "$kf")
                if [[ "$kc_val" == "$saved_val" ]]; then
                    basename "$kf" .keychain
                    return
                fi
            done
        fi
    fi

    # 심볼릭 링크 기준 감지
    if [[ -L "$ACTIVE_TOKEN" ]]; then
        local target
        target=$(readlink "$ACTIVE_TOKEN" || true)
        local base
        base=$(basename "$target")
        if [[ -f "$TOKEN_STORE/$base" ]]; then
            echo "$base"
            return
        fi
    fi

    if [[ -z "$(get_keychain_token)" && ! -e "$ACTIVE_TOKEN" ]]; then
        echo "none"
    else
        echo "unknown"
    fi
}

# 계정 상태 및 목록 출력
show_status() {
    local current
    current=$(get_current_account)

    echo -e "${BLUE}=== Google Antigravity (agy) 계정 상태 ===${RESET}"
    
    local found=0
    for file in "$TOKEN_STORE"/*; do
        [[ -e "$file" ]] || continue
        [[ "$file" =~ \.keychain$ ]] && continue
        [[ "$file" =~ \.bak$ ]] && continue

        found=1
        local acc
        acc=$(basename "$file")

        if [[ "$acc" == "$current" ]]; then
            echo -e "  ${GREEN}● $acc (활성)${RESET}"
        else
            echo -e "  ${CYAN}○ $acc${RESET}"
        fi
    done

    if [[ $found -eq 0 ]]; then
        echo -e "  ${YELLOW}(등록된 계정 토큰 파일이 없습니다)${RESET}"
    fi

    if [[ "$current" == "none" ]]; then
        echo -e "\n${YELLOW}안내: 현재 활성화된 토큰이 없습니다. agy 실행 시 브라우저 로그인이 열립니다.${RESET}"
    elif [[ "$current" == "unknown" ]]; then
        echo -e "\n${YELLOW}주의: 현재 토큰이 특정 등록 계정과 일치하지 않습니다.${RESET}"
        echo -e "현재 상태를 등록하려면: ${CYAN}agy-switch save [계정명]${RESET}"
    fi
}

# 계정 전환
switch_to() {
    local target_acc="$1"
    local json_file="$TOKEN_STORE/$target_acc"
    local kc_file="$TOKEN_STORE/$target_acc.keychain"

    if [[ ! -f "$json_file" && ! -f "$kc_file" ]]; then
        echo -e "${RED}오류: 계정 [$target_acc]의 저장된 토큰을 찾을 수 없습니다.${RESET}"
        echo -e "\n등록된 계정 목록:"
        show_status
        echo -e "\n새 계정을 등록하려면 브라우저 로그인 후 ${CYAN}agy-switch save $target_acc${RESET} 를 실행하세요."
        exit 1
    fi

    # 1. macOS Keychain 복원
    if $IS_DARWIN && [[ -f "$kc_file" ]]; then
        local val
        val=$(cat "$kc_file")
        set_keychain_token "$val"
    fi

    # 2. 파일 시스템 심볼릭 링크 갱신
    if [[ -f "$json_file" ]]; then
        ln -sfn "$json_file" "$ACTIVE_TOKEN"
        ln -sfn "$ACTIVE_TOKEN" "$LEGACY_ACTIVE_TOKEN"
    fi

    echo -e "${GREEN}✔ agy 활성 계정이 [$target_acc] (으)로 전환되었습니다.${RESET}"
    echo -e "${CYAN}💡 이미 실행 중인 agy 세션이 있다면, 종료(Ctrl+D) 후 다시 실행해야 새 계정이 적용됩니다.${RESET}"
}

# 현재 활성 토큰을 특정 계정으로 저장
save_current() {
    local target_acc="$1"
    local json_file="$TOKEN_STORE/$target_acc"
    local kc_file="$TOKEN_STORE/$target_acc.keychain"

    local saved=0

    # 1. macOS Keychain 저장
    if $IS_DARWIN; then
        local kc_val
        kc_val=$(get_keychain_token)
        if [[ -n "$kc_val" ]]; then
            echo "$kc_val" > "$kc_file"
            chmod 600 "$kc_file"
            saved=1

            # JSON 파일로도 디코딩하여 보관
            local b64="${kc_val#go-keyring-base64:}"
            if [[ "$b64" != "$kc_val" ]]; then
                echo "$b64" | base64 -d > "$json_file" 2>/dev/null || true
                chmod 600 "$json_file" 2>/dev/null || true
            fi
        fi
    fi

    # 2. 파일 토큰 저장 (Keychain이 없거나 파일이 있는 경우)
    if [[ -f "$ACTIVE_TOKEN" && ! -L "$ACTIVE_TOKEN" ]]; then
        cp -L "$ACTIVE_TOKEN" "$json_file"
        chmod 600 "$json_file"
        saved=1
    fi

    if [[ $saved -eq 0 && ! -f "$json_file" ]]; then
        echo -e "${RED}오류: 현재 활성화된 토큰(Keychain 또는 파일)을 찾을 수 없습니다.${RESET}"
        echo -e "먼저 agy를 실행하여 Google 로그인을 완료해주세요."
        exit 1
    fi

    # 심볼릭 링크 연결
    if [[ -f "$json_file" ]]; then
        ln -sfn "$json_file" "$ACTIVE_TOKEN"
        ln -sfn "$ACTIVE_TOKEN" "$LEGACY_ACTIVE_TOKEN"
    fi

    echo -e "${GREEN}✔ 현재 로그인 토큰이 계정 [$target_acc] (으)로 저장 및 활성화되었습니다.${RESET}"
}

# 새 계정 로그인 준비 모드
prepare_login() {
    local target_acc="$1"

    echo -e "${BLUE}=== 신규 계정 [$target_acc] 로그인 준비 ===${RESET}"

    # 1. 키체인에서 토큰 삭제
    delete_keychain_token

    # 2. 파일 토큰 및 심볼릭 링크 삭제
    rm -f "$ACTIVE_TOKEN" "$LEGACY_ACTIVE_TOKEN"
    rm -f "$CLI_DIR"/antigravity-oauth-token*

    echo -e "${GREEN}1. 키체인 및 디스크의 기존 토큰 연결을 완전히 분리했습니다.${RESET}"
    echo -e "${YELLOW}2. 이제 터미널에서 'agy' 를 실행하세요.${RESET}"
    echo -e "   - 브라우저 구글 로그인 화면이 열립니다."
    echo -e "   - [$target_acc] 구글 계정으로 로그인 및 승인을 완료하세요."
    echo -e "${CYAN}3. 로그인 후 agy를 종료(Ctrl+D)하고 다음 명령어를 실행하세요:${RESET}"
    echo -e "   ${GREEN}agy-switch save $target_acc${RESET}\n"
}

# 계정명 별칭 정규화 (p -> personal, o -> orca 등 단축어 지원)
normalize_acc() {
    local acc="$1"
    case "$acc" in
        p|pers|personal)
            echo "personal"
            ;;
        o|orc|orca)
            echo "orca"
            ;;
        b|by|bysong)
            echo "bysong"
            ;;
        s|sys|system)
            echo "system"
            ;;
        *)
            echo "$acc"
            ;;
    esac
}

# 도움말
show_help() {
    cat <<EOF
Google Antigravity CLI 계정 스위처 (agy-switch / as)

사용법:
  as (또는 agy-switch)            현재 활성 계정 및 등록된 계정 목록 확인
  as p (또는 as personal)         personal 계정으로 활성 계정 즉시 전환
  as o (또는 as orca)             orca 계정으로 활성 계정 즉시 전환
  as <계정명>                     지정한 계정으로 활성 토큰 전환
  as save <계정명/p/o>            현재 활성 토큰을 지정한 계정명으로 저장 및 활성화
  as login <계정명/p/o>           새 계정 로그인을 위해 기존 토큰을 분리하고 로그인 모드 진입
  as help                         이 도움말 표시

EOF
}

ACTION="${1:-status}"

case "$ACTION" in
    status|list)
        show_status
        ;;
    save)
        if [[ $# -lt 2 ]]; then
            echo -e "${RED}오류: 계정명을 지정해주세요. 예: as save p (또는 as save o)${RESET}"
            exit 1
        fi
        save_current "$(normalize_acc "$2")"
        ;;
    login|add)
        if [[ $# -lt 2 ]]; then
            echo -e "${RED}오류: 등록할 계정명을 지정해주세요. 예: as login p (또는 as login o)${RESET}"
            exit 1
        fi
        prepare_login "$(normalize_acc "$2")"
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        switch_to "$(normalize_acc "$ACTION")"
        ;;
esac
